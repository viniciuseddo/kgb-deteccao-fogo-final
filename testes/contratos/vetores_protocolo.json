{
  "versao_contrato": 1,
  "descricao": "Vetores compartilhados Python/C++ do protocolo protegido (design R2 §3-§5). Tempo t em ms desde o boot simulado. Ver LEIAME.md.",
  "constantes": {
    "v": 1,
    "caps": ["pan_manual", "watchdog", "bomba_protegida", "cancelar_sem_modo", "idempotencia"],
    "prazo_agua_ms": 5000,
    "cooldown_ms": 12000,
    "inibicao_boot_ms": 12000,
    "inibicao_cancel_ms": 12000,
    "lease_ms": 1500,
    "janela_ms": 500,
    "vel_validade_ms": 500,
    "vel_max_dps": 30,
    "pan_min": 10,
    "pan_max": 170,
    "varre_min": 30,
    "varre_max": 150,
    "dedup_retencao_ms": 120000,
    "dedup_capacidade": 32
  },
  "esquema_comando": {
    "comuns_obrigatorios": ["v", "boot_id", "sessao", "acao"],
    "por_acao": {
      "consultar": {"obrigatorios": ["ref"], "opcionais": []},
      "janela": {"obrigatorios": [], "opcionais": []},
      "manual": {"obrigatorios": ["seq", "id", "janela"], "opcionais": []},
      "auto": {"obrigatorios": ["seq", "id", "janela"], "opcionais": []},
      "renovar": {"obrigatorios": ["seq", "id", "janela"], "opcionais": []},
      "mover": {"obrigatorios": ["seq", "id", "janela", "vel"], "opcionais": []},
      "disparar": {"obrigatorios": ["seq", "id", "janela", "origem"], "opcionais": []},
      "cancelar": {"obrigatorios": ["seq", "id", "janela"], "um_de": ["cancel_ate", "alvo"]}
    },
    "origens": ["ia", "operador", "teclado"],
    "id_regex": "^[A-Za-z0-9_-]{1,32}$",
    "seq_max": 2147483647,
    "corpo_max_bytes": 512
  },
  "esquema_sessao": {"obrigatorios": ["v", "boot_id", "session_open_id", "janela"]},
  "motivos": [
    "json_invalido", "campo_desconhecido", "campo_ausente", "tipo_invalido", "valor_invalido",
    "versao", "boot", "sem_sessao", "sessao_obsoleta", "seq_antiga", "id_conflito",
    "janela_expirada", "janela_invalida", "epoch_obsoleto", "escopo",
    "acao_desconhecida", "recuperacao", "modo_auto", "sem_lease", "combate", "ocupado",
    "cooldown", "protecao_indisponivel", "alvo_obsoleto", "agua_legada_ativa", "perfil_protegido"
  ],
